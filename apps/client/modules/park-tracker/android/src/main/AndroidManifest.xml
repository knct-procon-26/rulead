<!--
  このモジュールのマニフェスト。prebuild / ビルド時にアプリのマニフェストへ自動でマージされる。
  アプリ側（app.json や android/）に同じ内容を書く必要はない。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" /> <!-- Android 14+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />           <!-- Android 13+ -->
    <!--
      「常に許可」。なくても動く（画面から開始したサービスは使用中の権限で位置を取れる）が、
      OS にサービスを止められた後の自動再開ができなくなる。
      入れる場合は Google Play Console でバックグラウンド位置情報の申告と審査が必要。
      不要なら、この行を消すか、app.json の android.blockedPermissions に書く。
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <application>
        <service
            android:name="expo.modules.parktracker.ParkTrackerService"
            android:foregroundServiceType="location"
            android:exported="false" />
    </application>
</manifest>
